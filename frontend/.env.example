# --- required (server-side; set these in Vercel -> Settings -> Environment Variables) ---

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/chatboot
# Atlas: Network Access must allow 0.0.0.0/0 - Vercel Functions have no fixed IPs.

JWT_SECRET=replace-with-a-long-random-string
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# 64 hex chars (32 bytes). If this ever changes, existing messages become
# unreadable, so set it once per environment and keep it stable forever.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- optional ---

# The API ships with this app as Route Handlers, so the client calls
# same-origin /api by default. Set this ONLY to point at a separately hosted
# backend (e.g. the legacy Express server in ../backend).
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Auth cookie. Same-origin means SameSite=Lax and Secure-in-production are
# right; override only if you split the app across domains.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

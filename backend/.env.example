# --- required ---
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS + Socket.IO).
# e.g. https://chatboot.vercel.app
FRONTEND_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/chatboot

JWT_SECRET=replace-with-a-long-random-string
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# 64 hex chars (32 bytes). If this ever changes, existing messages become
# unreadable, so set it once per environment and keep it stable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- production knobs (optional; sensible defaults for local dev) ---
# When frontend and backend are on different domains the auth cookie must be:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com   # only if sharing a parent domain
# TRUST_PROXY=true             # auto-on when NODE_ENV=production
